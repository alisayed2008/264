# Database — any standard Postgres 15+ connection string (Neon, Supabase, self-hosted, etc.)
# ARCHITECTURE.md §12 — provider deliberately not chosen at the architecture level.
DATABASE_URL="postgresql://user:password@localhost:5432/real_estate_platform"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com — OAuth 2.0 Client ID, Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI — server-only, never exposed to the browser. Not used until Phase 5.
OPENAI_API_KEY=""

# AI model selection — set at Phase 5 implementation time. AI.md §3: never assume
# a model name from any document, verify against the live account first.
AI_RECOMMENDATION_MODEL=""
AI_COMPARISON_MODEL=""

# Provider abstractions (ARCHITECTURE.md §12) — not exercised until their features
# ship (media upload: Phase 3; async AI jobs: Phase 5). Declared now so the env
# schema is complete from Phase 1.
MEDIA_STORAGE_PROVIDER=""
ASYNC_JOB_PROVIDER=""

# Public — safe for the browser, deliberately prefixed
NEXT_PUBLIC_APP_URL="http://localhost:3000"
